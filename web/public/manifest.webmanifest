{
  "name": "Easylab Lab Notebook",
  "short_name": "Lab Notebook",
  "description": "Daily lab notes, entry file boxes, attachments, and Google Drive sync.",
  "start_url": "/?pwa=1",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4efe5",
  "theme_color": "#053f32",
  "orientation": "any",
  "icons": [
    {
      "src": "/pwa-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/?share-target=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "application/pdf", "text/*", ".csv", ".tsv", ".xlsx", ".xls", ".doc", ".docx"]
        }
      ]
    }
  }
}
