{
  "precondition": "must-not-exist",
  "scope": "offline-cross-client-transaction-only",
  "identity": {
    "property": "easylabCreateFingerprint",
    "inputs": ["verifiedPath", "mimeType", "contentSha256", "canonicalAppProperties"],
    "deterministic": true
  },
  "missingPath": {
    "decision": "create-once",
    "method": "multipart-post",
    "overwriteAllowed": false
  },
  "uploadModes": {
    "boundedMultipart": {
      "maximumExclusiveBytes": 5242880,
      "method": "multipart-post",
      "generatedFileIdRequired": false
    },
    "resumable": {
      "minimumInclusiveBytes": 5242880,
      "method": "resumable-post",
      "generatedFileIdRequired": true,
      "persistBeforeContentTransfer": true,
      "pathReservation": "parent-folder-etag-cas",
      "reservationScope": "canonical-path-hash",
      "independentRecovery": "adopt-exact-generated-id-and-fingerprint"
    }
  },
  "existingPath": {
    "exactIdentityAndContent": "reconcile-as-success",
    "mismatch": "precondition-conflict",
    "duplicates": "precondition-conflict"
  },
  "ambiguousOutcome": {
    "reconcileRequires": [
      "one-path-match",
      "creation-fingerprint-match",
      "metadata-match",
      "downloaded-content-sha256-match",
      "stable-second-metadata-read"
    ],
    "otherwise": "ambiguous-commit"
  },
  "runtime": {
    "productionWired": false,
    "webProductionWired": false,
    "nativeDriveWritesAllowed": false,
    "liveDriveValidationPerformed": false
  }
}
